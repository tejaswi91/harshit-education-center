PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/harshit_education
# Sockets per process. Keep low on serverless hosts, where many instances share
# the database's connection limit.
MONGODB_MAX_POOL_SIZE=5
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
# Reverse-proxy hops to trust for X-Forwarded-For. Use 0 when nothing proxies
# the app, 1 behind a single nginx/ALB hop. Rate limiting keys off the client IP.
# Vercel sits in front of the app, so deployed environments use 1.
TRUST_PROXY=0
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=
# Largest accepted upload, in megabytes. Vercel rejects request bodies over
# 4.5 MB before the app runs, so serverless deployments must set 4.
UPLOAD_MAX_MB=15
