PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/harshit_education
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
# Reverse-proxy hops to trust for X-Forwarded-For. Use 0 when nothing proxies
# the app, 1 behind a single nginx/ALB hop. Rate limiting keys off the client IP.
TRUST_PROXY=0
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=
